{
  "name": "codexapp",
  "version": "0.1.87",
  "description": "Codex WebUI: a lightweight web interface for Codex that runs on top of the Codex app-server, allowing remote access from any browser",
  "type": "module",
  "license": "MIT",
  "author": "Pavel Voronin, Igor Levochkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoto-aoki-fy/codex-webui.git"
  },
  "homepage": "https://github.com/naoto-aoki-fy/codex-webui#readme",
  "bugs": {
    "url": "https://github.com/naoto-aoki-fy/codex-webui/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "web-ui",
    "remote",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codexapp": "dist-cli/index.js",
    "codexui": "dist-cli/index.js"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:open": "pnpm run build:cli && sh -c 'pnpm run dev & VPID=$!; node dist-cli/index.js --open-project \"${1:-.}\"; wait $VPID' --",
    "build:frontend": "vue-tsc --noEmit && vite build && node scripts/precompress-assets.cjs",
    "build:cli": "tsup",
    "build": "pnpm run build:frontend && pnpm run build:cli",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "profile:browser": "node scripts/profile-browser-runtime.cjs",
    "profile:thread": "PROFILE_ROUTE='#/thread/019da7c0-4e12-7a91-837c-f7c11cc8ab6c' node scripts/profile-browser-runtime.cjs",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:integration:fixture": "node scripts/test-external-app-server.cjs",
    "generate:project-file-protocol": "node scripts/generate-project-file-protocol.cjs",
    "test:integration:project-files:live": "CODEX_PROJECT_FILES_LIVE=1 vitest run src/server/projectFiles.live.test.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "mime-types": "^3.0.2",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@openai/codex": "0.167.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.13.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.5",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@10.34.9"
}
